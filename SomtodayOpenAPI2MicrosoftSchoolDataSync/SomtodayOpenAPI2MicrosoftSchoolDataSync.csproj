<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SomtodayOpenAPI2MicrosoftSchoolDataSync</RootNamespace>
    <AssemblyName>SomtodayOpenAPI2MicrosoftSchoolDataSync</AssemblyName>
    <ApplicationIcon>Resources\SOMSDS.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version Condition="'$(Version)' == ''">0.0.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AppConfig>App.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.11" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="R:\openapi.json" Link="OpenAPIs\openapi.json">
      <ClassName>SomOpenApiClient</ClassName>
      <CodeGenerator>NSwagCSharp</CodeGenerator>
    </None>
  </ItemGroup>

</Project>
