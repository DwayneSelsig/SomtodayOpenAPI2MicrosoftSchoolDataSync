<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SomtodayOpenAPI2MicrosoftSchoolDataSync</RootNamespace>
    <AssemblyName>SomtodayOpenAPI2MicrosoftSchoolDataSync</AssemblyName>
    <ApplicationIcon>Resources\SOMSDS.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppConfig>App.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Properties\VersionInfo.cs" />
    <None Include="R:\openapi.json" Link="OpenAPIs\openapi.json">
      <ClassName>SomOpenApiClient</ClassName>
      <CodeGenerator>NSwagCSharp</CodeGenerator>
    </None>
  </ItemGroup>

</Project>
